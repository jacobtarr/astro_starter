---
import '@fontsource-variable/geist/wght.css';
import '@styles/index.css';
import Head from '@globals/head/Head.astro';

interface Props {
  bodyClass?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  bodyClass = '',
  title,
  description,
  ogImage,
  ogType,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html class="no-js" lang="en">
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>