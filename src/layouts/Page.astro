---
/*
  Layout: Page

  Middle layer between Base and page templates.
  Handles page wrapper and optional container.

  Props:
    title?: string                    # Page title (default: site title)
    description?: string              # Meta description (default: site description)
    ogImage?: string                  # Open Graph / Twitter card image URL
    ogType?: 'website' | 'article'    # Open Graph type (default: 'website')
    jsonLd?: Record<string, unknown>  # Structured data object, rendered as JSON-LD
    useContainer?: boolean            # Wrap content in container (default: false)
    containerClasses?: string         # Additional classes for .l-page-container

  Examples:
    <Page>
      content
    </Page>

    <Page useContainer containerClasses="py-16">
      content
    </Page>
*/

import Base from './Base.astro';
import Header from '@globals/header/Header.astro';
import Footer from '@globals/footer/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  useContainer?: boolean;
  containerClasses?: string;
}

const slug = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'home';
const bodyClass = `l-body-${slug}`;
const pageClass = `l-page-container l-page-${slug}`;

const {
  title,
  description,
  ogImage,
  ogType,
  jsonLd,
  useContainer = false,
  containerClasses = '',
} = Astro.props;

const containerClassName = ['l-page-container__inner container mx-auto', containerClasses].filter(Boolean).join(' ');
---

<Base
  bodyClass={bodyClass}
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  jsonLd={jsonLd}
>
  <Header />
  <main class="l-site-container">
    <div class={pageClass}>
      {useContainer ? (
        <div class={containerClassName}>
          <slot />
        </div>
      ) : (
        <slot />
      )}
    </div>
  </main>
  <Footer />
</Base>