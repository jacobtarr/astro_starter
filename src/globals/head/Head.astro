---
/*
  Head Component

  Handles all meta tags, SEO, and document head concerns.
  Import your global CSS here so it's included on every page.

  Props:
    title?: string                        # Page title (default: site title)
    description?: string                  # Meta description (default: site description)
    ogImage?: string                      # Open Graph / Twitter card image URL
    ogType?: 'website' | 'article'        # Open Graph type (default: 'website')
    jsonLd?: Record<string, unknown>      # Structured data object, rendered as JSON-LD

  Examples:
    <Head title="About" description="About this site" />

    <Head
      title={post.data.title}
      description={post.data.excerpt}
      ogImage={post.data.thumbnail}
      ogType="article"
      jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: post.data.title,
      }}
    />
*/

import { ClientRouter } from 'astro:transitions';
import { siteTitle, siteDescription } from '@src/consts';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = siteDescription,
  ogImage,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} - ${siteTitle}` : siteTitle;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : null;
---

<meta charset="utf-8" />
<meta http-equiv="x-ua-compatible" content="ie=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
{canonicalURL && <link rel="canonical" href={canonicalURL} />}

<link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

<title>{pageTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}

<ClientRouter />